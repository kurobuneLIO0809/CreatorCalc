{
  "name": "quickconvert",
  "version": "0.1.0",
  "private": true,
  "description": "Free, account-free image tools that run in the browser. Static site for Cloudflare Pages.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/licenses.mjs && node scripts/postbuild.mjs",
    "preview": "node scripts/serve.mjs",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "og": "node scripts/generate-og.mjs",
    "verify": "npm run check && npm test && npm run build && npm run test:e2e"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kurobuneLIO0809/CreatorCalc.git"
  },
  "dependencies": {
    "@astrojs/preact": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@jsquash/webp": "^1.5.0",
    "astro": "^7.3.5",
    "exifr": "^7.1.3",
    "fflate": "^0.8.3",
    "heic-to": "^1.5.2",
    "pdf-lib": "^1.17.1",
    "preact": "^10.29.8",
    "upng-js": "^2.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.55",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
