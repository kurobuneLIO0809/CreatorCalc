---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';
import { LOCALE_INFO, LOCALES, type Alternates, type Locale } from '../i18n';

interface Props {
  title: string;
  description: string;
  /** Path without trailing slash, e.g. "/tools/image-resizer". */
  path: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  locale?: Locale;
  /** Translations of this page (locale → path). Used for hreflang and the language menu. */
  alternates?: Alternates;
}

const { title, description, path, ogImage = '/og/default.png', jsonLd = [], noindex = false, locale = 'en', alternates = {} } = Astro.props;
const info = LOCALE_INFO[locale];
const origin = (Astro.site?.toString() ?? '').replace(/\/+$/, '');
const canonical = `${origin}${path === '/' ? '/' : path}`;
const fullTitle = title.includes(site.name) || title.length + site.name.length + 3 > 62 ? title : `${title} | ${site.name}`;
const ogUrl = `${origin}${ogImage}`;
// hreflang only between pages that really are translations of each other.
const hreflang =
  Object.keys(alternates).length > 1 && !noindex
    ? LOCALES.filter((l) => alternates[l]).map((l) => ({ lang: LOCALE_INFO[l].htmlLang, href: `${origin}${alternates[l]}` }))
    : [];
const xDefault = hreflang.length > 0 && alternates.en ? `${origin}${alternates.en}` : null;
// Preview deployments on Cloudflare Pages must not be indexed.
const branch = process.env.CF_PAGES_BRANCH;
const isPreview = !!branch && branch !== (process.env.PRODUCTION_BRANCH || 'main');
const robots = noindex || isPreview ? 'noindex, follow' : 'index, follow, max-image-preview:large';
const safeJson = (data: unknown) => JSON.stringify(data).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={info.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    {hreflang.map((h) => <link rel="alternate" hreflang={h.lang} href={h.href} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content={site.themeColorLight} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={site.themeColorDark} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={info.ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${title}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <script is:inline src="/theme-init.js"></script>
    {jsonLd.map((data) => <script type="application/ld+json" set:html={safeJson(data)} />)}
  </head>
  <body>
    <Header locale={locale} alternates={alternates} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
