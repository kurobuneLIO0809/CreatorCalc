---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  heading: string;
  description: string;
  path: string;
  lead?: string;
  noindex?: boolean;
}
const { title, heading, description, path, lead, noindex } = Astro.props;
const origin = (Astro.site?.toString() ?? '').replace(/\/+$/, '');
const jsonLd = noindex
  ? []
  : [
      {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: `${origin}/` },
          { '@type': 'ListItem', position: 2, name: heading, item: `${origin}${path}` },
        ],
      },
    ];
---

<BaseLayout title={title} description={description} path={path} noindex={noindex} jsonLd={jsonLd}>
  <div class="container">
    <header class="page-head">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-current="page">{heading}</li>
        </ol>
      </nav>
      <h1>{heading}</h1>
      {lead && <p class="page-head__lead">{lead}</p>}
    </header>
    <article class="prose">
      <slot />
    </article>
  </div>
</BaseLayout>
