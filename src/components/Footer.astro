---
import { site } from '../config/site';
import { toolPath } from '../data/tools';
import { localePath, localizedTools, siteT, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = siteT(locale);
const popular = localizedTools(locale).filter((t) => t.popular);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div>
        <h2>{site.name}</h2>
        <p class="muted">{tr('meta.tagline')}</p>
      </div>
      <nav aria-label={tr('footer.popular')}>
        <h2>{tr('footer.popular')}</h2>
        <ul>
          {popular.map((t) => <li><a href={localePath(locale, toolPath(t.slug))}>{t.name}</a></li>)}
        </ul>
      </nav>
      <nav aria-label={tr('footer.site')}>
        <h2>{tr('footer.site')}</h2>
        <ul>
          <li><a href={localePath(locale, '/tools')}>{tr('nav.allTools')}</a></li>
          <li><a href="/methodology">{tr('nav.howItWorks')}</a></li>
          <li><a href="/about">{tr('footer.about')}</a></li>
          <li><a href="/privacy">{tr('footer.privacy')}</a></li>
          <li><a href="/terms">{tr('footer.terms')}</a></li>
          <li><a href="/contact">{tr('footer.contact')}</a></li>
          <li><a href="/third-party-licenses.txt">{tr('footer.licences')}</a></li>
        </ul>
      </nav>
    </div>
    <p class="site-footer__bottom">© {year} {site.name}. {tr('footer.notice')}</p>
  </div>
</footer>
