---
import ToolIcon from './ToolIcon.astro';
import { toolPath, type ToolMeta } from '../data/tools';
interface Props {
  tools: ToolMeta[];
  searchable?: boolean;
  headingLevel?: 'h2' | 'h3';
}
const { tools, searchable = false } = Astro.props;
---

<ul class="tool-grid" data-tool-grid={searchable ? '' : undefined}>
  {
    tools.map((t) => (
      <li data-search={searchable ? `${t.name} ${t.tagline} ${t.searchTerms.join(' ')}`.toLowerCase() : undefined}>
        <a class="tool-link" href={toolPath(t.slug)}>
          <span class="tool-link__icon">
            <ToolIcon name={t.icon} />
          </span>
          <span>
            <span class="tool-link__name">{t.name}</span>
            <span class="tool-link__desc">{t.tagline}</span>
          </span>
        </a>
      </li>
    ))
  }
</ul>
