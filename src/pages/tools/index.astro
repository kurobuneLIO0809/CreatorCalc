---
import { site } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolGrid from '../../components/ToolGrid.astro';
import SearchBox from '../../components/SearchBox.astro';
import { categories } from '../../data/categories';
import { tools } from '../../data/tools';

const live = categories.filter((c) => c.status === 'live');
const planned = categories.filter((c) => c.status === 'planned');
const origin = (Astro.site?.toString() ?? '').replace(/\/+$/, '');
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${origin}/` },
      { '@type': 'ListItem', position: 2, name: 'Tools', item: `${origin}/tools` },
    ],
  },
];
---

<BaseLayout
  title="All Free Image Tools – Compress, Convert, Resize, PDF"
  description={`Every ${site.name} tool in one place: image compressor, resizer, HEIC/WebP/PNG/JPG converters, image to PDF, cropper and EXIF remover. Free and private.`}
  path="/tools"
  jsonLd={jsonLd}
>
  <div class="container">
    <header class="page-head">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-current="page">Tools</li>
        </ol>
      </nav>
      <h1>All tools</h1>
      <p class="page-head__lead">{tools.length} free tools that run entirely in your browser. More categories will be added based on what people need most.</p>
    </header>
    <SearchBox />
    {
      live.map((cat) => (
        <section class="section" aria-labelledby={`cat-${cat.id}`} data-search-section>
          <div class="section__head">
            <h2 id={`cat-${cat.id}`}>{cat.name}</h2>
            <span class="muted">{cat.description}</span>
          </div>
          <ToolGrid tools={tools.filter((t) => t.category === cat.id)} searchable />
        </section>
      ))
    }
    <section class="section" aria-labelledby="planned-heading">
      <h2 id="planned-heading">Planned next</h2>
      <p class="muted">These categories are on the roadmap. They will only be published when the tools are genuinely ready.</p>
      <ul>
        {planned.map((c) => <li><strong>{c.name}</strong> — {c.description}</li>)}
      </ul>
    </section>
  </div>
</BaseLayout>
