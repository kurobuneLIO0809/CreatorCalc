---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolIsland from '../../components/ToolIsland.astro';
import ToolGrid from '../../components/ToolGrid.astro';
import { site } from '../../config/site';
import { content } from '../../data/content';
import { getTool, tools, toolPath, type ToolMeta } from '../../data/tools';

export function getStaticPaths() {
  return tools.map((tool) => ({ params: { slug: tool.slug }, props: { tool } }));
}

interface Props {
  tool: ToolMeta;
}

const { tool } = Astro.props;
const c = content[tool.slug];
const related = tool.related.map(getTool);
const origin = (Astro.site?.toString() ?? '').replace(/\/+$/, '');
const url = `${origin}${toolPath(tool.slug)}`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: tool.h1,
    url,
    description: tool.description,
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Any (web browser)',
    browserRequirements: 'Requires JavaScript and a modern browser',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@type': 'Organization', name: site.name, url: `${origin}/` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${origin}/` },
      { '@type': 'ListItem', position: 2, name: 'Tools', item: `${origin}/tools` },
      { '@type': 'ListItem', position: 3, name: tool.name, item: url },
    ],
  },
];
---

<BaseLayout title={tool.title} description={tool.description} path={toolPath(tool.slug)} ogImage={`/og/${tool.slug}.png`} jsonLd={jsonLd}>
  <div class="container">
    <header class="page-head">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li><a href="/tools">Tools</a></li>
          <li aria-current="page">{tool.name}</li>
        </ol>
      </nav>
      <h1>{tool.h1}</h1>
      <p class="page-head__lead">{tool.tagline}</p>
      <p class="privacy-pill">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4 6v6c0 5 3.4 8.3 8 9 4.6-.7 8-4 8-9V6z" fill="none" stroke="currentColor" stroke-width="2"></path></svg>
        Runs in your browser · files are not uploaded
      </p>
    </header>

    <section class="tool-card" aria-label={`${tool.name} tool`}>
      <ToolIsland slug={tool.slug} />
    </section>

    <div class="content-grid">
      <section class="content-block prose" aria-labelledby="about-heading">
        <h2 id="about-heading">About this tool</h2>
        {c.intro.map((p) => <p>{p}</p>)}
      </section>

      <section class="content-block" aria-labelledby="howto-heading">
        <h2 id="howto-heading">How to use it</h2>
        <ol class="steps">
          {c.steps.map((s) => <li>{s}</li>)}
        </ol>
      </section>

      <section class="content-block" aria-labelledby="uses-heading">
        <h2 id="uses-heading">When it helps</h2>
        <div class="use-cases">
          {
            c.useCases.map((u) => (
              <div class="use-case">
                <h3>{u.title}</h3>
                <p>{u.text}</p>
              </div>
            ))
          }
        </div>
      </section>

      <section class="content-block" aria-labelledby="specs-heading">
        <h2 id="specs-heading">Specifications</h2>
        <table class="spec-table">
          <tbody>
            {
              c.specs.map(([k, v]) => (
                <tr>
                  <th scope="row">{k}</th>
                  <td>{v}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </section>

      <section class="content-block prose" aria-labelledby="limits-heading">
        <h2 id="limits-heading">Limitations and notes</h2>
        <ul class="limits">
          {c.limits.map((l) => <li>{l}</li>)}
        </ul>
        <p class="muted">Full details on formats and processing are on the <a href="/methodology">methodology page</a>.</p>
      </section>

      <section class="content-block faq" aria-labelledby="faq-heading">
        <h2 id="faq-heading">Frequently asked questions</h2>
        {
          c.faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </section>

      <section class="content-block" aria-labelledby="related-heading">
        <h2 id="related-heading">Related tools</h2>
        <ToolGrid tools={related} />
      </section>
    </div>
  </div>
  <script is:inline data-tool-slug={tool.slug} src="/recent.js"></script>
</BaseLayout>
