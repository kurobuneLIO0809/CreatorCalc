---
import ToolPage from '../../views/ToolPage.astro';
import { tools } from '../../data/tools';

export function getStaticPaths() {
  return tools.map((tool) => ({ params: { slug: tool.slug } }));
}

const { slug } = Astro.params as { slug: (typeof tools)[number]['slug'] };
---

<ToolPage slug={slug} locale="en" />
