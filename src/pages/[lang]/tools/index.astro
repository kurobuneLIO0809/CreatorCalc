---
import ToolsIndexPage from '../../../views/ToolsIndexPage.astro';
import { TRANSLATED_LOCALES, type Locale } from '../../../i18n';

export function getStaticPaths() {
  return TRANSLATED_LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
---

<ToolsIndexPage locale={lang} />
