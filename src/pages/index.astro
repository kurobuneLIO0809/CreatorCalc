---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolGrid from '../components/ToolGrid.astro';
import SearchBox from '../components/SearchBox.astro';
import { site } from '../config/site';
import { tools, toolPath } from '../data/tools';

const popular = tools.filter((t) => t.popular);
const groups = [
  { title: 'Compress & resize', slugs: ['image-compressor', 'compress-image-to-kb', 'image-resizer'] },
  { title: 'Convert formats', slugs: ['heic-to-jpg', 'webp-to-jpg', 'png-to-jpg', 'jpg-to-png', 'image-to-webp', 'image-converter'] },
  { title: 'Edit & combine', slugs: ['image-cropper', 'rotate-image', 'image-to-pdf'] },
  { title: 'Privacy', slugs: ['exif-viewer', 'remove-exif'] },
].map((g) => ({ ...g, tools: g.slugs.map((s) => tools.find((t) => t.slug === s)).filter((t) => t !== undefined) }));

const origin = (Astro.site?.toString() ?? '').replace(/\/+$/, '');
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: `${origin}/`,
    description: site.description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.name,
    url: `${origin}/`,
    logo: `${origin}/icon-512.png`,
  },
];
const index = tools.map((t) => ({ slug: t.slug, name: t.name, href: toolPath(t.slug) }));
const faq = [
  {
    q: `Is ${site.name} really free?`,
    a: 'Yes. All tools are free to use without an account, watermark or daily limit. Because processing happens on your device, serving the site costs us very little.',
  },
  {
    q: 'Are my files uploaded?',
    a: 'No. Images are processed by your browser using built-in image APIs and WebAssembly. The site has no upload endpoint, and its Content Security Policy blocks pages from sending data to other websites.',
  },
  {
    q: 'Do the tools work on my phone?',
    a: 'Yes. Every tool works in current mobile browsers on iPhone and Android, including selecting photos straight from your gallery. Very large images are automatically scaled to fit phone memory limits.',
  },
  {
    q: 'Is there a file size limit?',
    a: 'Up to 100 MB per image and 50 images per batch. The real limit is your device’s memory — very large panoramas may be scaled down, and you will see a note when that happens.',
  },
  {
    q: 'Can I use the tools offline?',
    a: 'Mostly. Once a tool page has loaded, processing itself needs no connection. Some tools download an extra component the first time it is needed — for example the WebP encoder in Safari — so load those once while online.',
  },
];
---

<BaseLayout title="Free Image Tools – Compress, Resize & Convert, No Upload" description={site.description} path="/" jsonLd={jsonLd}>
  <div class="container">
    <section class="hero">
      <h1>Fix your images in seconds — right in your browser</h1>
      <p class="hero__lead">Compress, resize, convert WebP, PNG and JPG, make PDFs and remove hidden location data. Free, no account, and your files stay on your device.</p>
      <ul class="hero__points">
        <li>No sign-up</li>
        <li>No upload</li>
        <li>No watermark</li>
        <li>Works on phones</li>
      </ul>
      <SearchBox />
    </section>

    <section class="section" aria-labelledby="popular-heading" data-search-section>
      <div class="section__head">
        <h2 id="popular-heading">Popular tools</h2>
        <a href="/tools">All tools →</a>
      </div>
      <ToolGrid tools={popular} searchable />
    </section>

    <section class="section" aria-labelledby="recent-heading" id="recent-section" hidden>
      <div class="section__head">
        <h2 id="recent-heading">Recently used</h2>
      </div>
      <ul class="tool-grid" id="recent-list"></ul>
    </section>

    {
      groups.map((g) => (
        <section class="section" aria-label={g.title} data-search-section>
          <div class="section__head">
            <h2>{g.title}</h2>
          </div>
          <ToolGrid tools={g.tools} searchable />
        </section>
      ))
    }

    <section class="section" aria-labelledby="privacy-heading">
      <div class="section__head">
        <h2 id="privacy-heading">Your files stay on your device</h2>
      </div>
      <div class="feature-grid">
        <div class="feature">
          <h3>Processed in your browser</h3>
          <p>Images are decoded and saved by your browser on your own computer or phone — no waiting for uploads and downloads.</p>
        </div>
        <div class="feature">
          <h3>Technically blocked from sending files</h3>
          <p>Every page carries a strict Content Security Policy that only allows connections back to this site, which has no upload endpoint.</p>
        </div>
        <div class="feature">
          <h3>Nothing to sign up for</h3>
          <p>No account, no email, no cookies for tracking. Close the tab and the files are gone from memory.</p>
        </div>
        <div class="feature">
          <h3>Check it yourself</h3>
          <p>Open your browser’s developer tools, go to the Network tab and use any tool: you will see no request containing your file. <a href="/methodology">How it works</a></p>
        </div>
      </div>
    </section>

    <section class="section faq" aria-labelledby="faq-heading">
      <h2 id="faq-heading">Questions</h2>
      {
        faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </section>
  </div>
  <script type="application/json" id="tool-index" set:html={JSON.stringify(index).replace(/</g, '\\u003c')} />
  <script>
    // "Recently used" is read from this browser only; it contains tool names, never files.
    try {
      const index: Array<{ slug: string; name: string; href: string }> = JSON.parse(document.getElementById('tool-index')?.textContent ?? '[]');
      const recent: unknown = JSON.parse(localStorage.getItem('recentTools') ?? '[]');
      const list = document.getElementById('recent-list');
      const section = document.getElementById('recent-section');
      if (Array.isArray(recent) && list && section) {
        const items = recent.map((slug) => index.find((t) => t.slug === slug)).filter((t): t is (typeof index)[number] => !!t);
        for (const t of items) {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.className = 'tool-link';
          a.href = t.href;
          const name = document.createElement('span');
          name.className = 'tool-link__name';
          name.textContent = t.name;
          a.append(name);
          li.append(a);
          list.append(li);
        }
        section.hidden = items.length === 0;
      }
    } catch {
      /* storage unavailable */
    }
  </script>
</BaseLayout>
